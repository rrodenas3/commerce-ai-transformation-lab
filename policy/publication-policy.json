{
  "allowed_evidence_statuses": [
    "research-grounded",
    "synthetic-observed",
    "human-reviewed",
    "hypothetical-impact"
  ],
  "allowed_knowledge_types": [
    "client-fact",
    "observation",
    "external-research",
    "raul-method",
    "assumption",
    "hypothesis",
    "recommendation",
    "generated-content",
    "decision",
    "approved-learning"
  ],
  "allowed_maturities": [
    "foundation",
    "specification",
    "local-mvp",
    "independently-reviewed-local-mvp",
    "pilot",
    "production"
  ],
  "current_maturity": "foundation",
  "allowed_review_states": [
    "accepted-public-source"
  ],
  "allowed_sensitivities": [
    "public"
  ],
  "allowed_visual_evidence_boundaries": [
    "explanatory-only"
  ],
  "required_journey_fields": [
    "evidence_status",
    "public_safe",
    "maturity",
    "limitations"
  ],
  "canonical_source_globs": [
    "docs/company-playbook/*.md",
    "docs/plans/*.md"
  ],
  "required_canonical_source_fields": [
    "source",
    "owner",
    "version",
    "evidence_status",
    "sensitivity",
    "permitted_use",
    "review_state",
    "replacement_or_expiry",
    "knowledge_type",
    "authority_scope",
    "conflict_policy",
    "generated_content_authority",
    "visual_evidence_boundary",
    "regression_trigger",
    "outcome_evidence",
    "research_as_of",
    "source_freshness"
  ],
  "source_release_globs": [
    "policy/publication-policy.json",
    "README.md",
    "docs/DECISION_LOG.md",
    "docs/EVIDENCE_POLICY.md",
    "docs/RESEARCH_BASE.md",
    "docs/STAGE1_*.md",
    "docs/FIRST_VERTICAL_SLICE.md",
    "docs/PROJECT_CHARTER.md",
    "docs/company-playbook/*.md",
    "docs/plans/*.md",
    "journey/*.md",
    "journey/**/*.md"
  ],
  "required_source_release_paths": [
    "policy/publication-policy.json",
    "README.md",
    "docs/DECISION_LOG.md",
    "docs/EVIDENCE_POLICY.md",
    "docs/RESEARCH_BASE.md",
    "docs/STAGE1_OPERATING_MODEL.md",
    "docs/STAGE1_RESEARCH_NOTES.md",
    "docs/FIRST_VERTICAL_SLICE.md",
    "docs/PROJECT_CHARTER.md",
    "docs/company-playbook/README.md",
    "docs/company-playbook/01_EXECUTIVE_BLUEPRINT.md",
    "docs/company-playbook/02_SYSTEM_MODEL_ONTOLOGY_TOPOLOGY_ARCHITECTURE.md",
    "docs/company-playbook/03_TRANSFORMATION_DELIVERY_MANUAL.md",
    "docs/company-playbook/04_ENABLEMENT_AND_ADOPTION_PLAYBOOK.md",
    "docs/company-playbook/05_USE_CASE_PORTFOLIO_AND_PATTERNS.md",
    "docs/company-playbook/06_GOVERNANCE_RISK_AND_EVIDENCE.md",
    "docs/company-playbook/07_WORKSHOPS_CANVASES_AND_COMMUNICATION.md",
    "docs/company-playbook/08_FRAMEWORK_CROSSWALK_AND_SOURCES.md",
    "docs/company-playbook/09_VISUAL_SYSTEM_AND_INFOGRAPHIC_PROMPTS.md",
    "docs/plans/2026-08-10-001-feat-rausellos-engagement-engine-plan.md"
  ],
  "evidence_artifact_globs": [
    "README.md",
    "journey/*.md",
    "journey/**/*.md",
    "docs/*.md",
    "docs/**/*.md"
  ],
  "forbidden_file_names": [
    ".env",
    "credentials.json",
    "secrets.json",
    "id_rsa",
    "id_ed25519"
  ],
  "forbidden_file_suffixes": [
    ".pem",
    ".key",
    ".p12",
    ".pfx"
  ],
  "forbidden_path_globs": [
    ".env.*",
    "*.sqlite",
    "*.sqlite3",
    "*.db",
    "tmp/**",
    "artifacts/private/**",
    "data/private/**"
  ],
  "forbidden_text_patterns": [
    {
      "name": "private Windows user path",
      "pattern": "(?i)[A-Z]:\\\\Users\\\\"
    },
    {
      "name": "private macOS user path",
      "pattern": "(?<![A-Za-z0-9._:/-])/Users/[A-Za-z0-9._-]+(?:/[^\\s]*)?"
    },
    {
      "name": "private Linux user path",
      "pattern": "(?<![A-Za-z0-9._:/-])/home/[A-Za-z0-9._-]+(?:/[^\\s]*)?"
    },
    {
      "name": "private key material",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
    },
    {
      "name": "GitHub personal access token",
      "pattern": "\\b(?:ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\\b"
    },
    {
      "name": "OpenAI-style secret key",
      "pattern": "\\bsk-[A-Za-z0-9_-]{16,}\\b"
    },
    {
      "name": "AWS access key",
      "pattern": "\\bAKIA[0-9A-Z]{16}\\b"
    }
  ],
  "allowed_binary_files": [],
  "required_root_files": [
    "README.md",
    "SECURITY.md",
    "docs/EVIDENCE_POLICY.md",
    "docs/DECISION_LOG.md",
    "data/README.md"
  ]
}
