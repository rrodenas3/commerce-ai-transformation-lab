    "artifacts/private/**",
    "data/private/**"
  ],
  "forbidden_text_patterns": [
    {
      "name": "private Windows user path",
      "pattern": "(?i)[A-Z]:\\\\Users\\\\"
    },
    {
      "name": "private macOS user path",
      "pattern": "(?<![A-Za-z0-9._:/-])/Users/[A-Za-z0-9._-]+(?:/[^\\s]*)?"
    },
    {
      "name": "private Linux user path",
      "pattern": "(?<![A-Za-z0-9._:/-])/home/[A-Za-z0-9._-]+(?:/[^\\s]*)?"
    },
    {
      "name": "private key material",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
    },
    {
      "name": "GitHub personal access token",
      "pattern": "\\b(?:ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})\\b"
    },
    {
      "name": "OpenAI-style secret key",
      "pattern": "\\bsk-[A-Za-z0-9_-]{16,}\\b"
    },
    {
      "name": "AWS access key",
      "pattern": "\\bAKIA[0-9A-Z]{16}\\b"
    }
  ],
